# Copy this file to .env.development for local development only.
# Never commit .env.development or production secrets.
DISCORD_TOKEN=replace-with-a-development-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id
DISCORD_GUILD_ID=replace-with-your-development-guild-id

DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=debug
